---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import PrimaryButton from '../components/PrimaryButton.astro';
import SecondaryButton from '../components/SecondaryButton.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ProofChip from '../components/ProofChip.astro';
import WorkCard from '../components/WorkCard.astro';
import TimelineItem from '../components/TimelineItem.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import { site } from '../data/site';

const proofChips = ['88-country global launch', '200+ engineer performance program', 'Platform for 6+ teams', 'Secure console payments', 'Production AI systems'];

const workEntries = (await getCollection('work'))
  .filter(entry => entry.data.status === 'published')
  .sort((a, b) => a.data.order - b.data.order);

const signatureCards = [
  {
    title: 'Global customer-facing architecture',
    body: 'Defined the technical strategy for commerce across web, mobile, and console spanning 88 countries, 23 marketplaces, and 5+ organizations, including secure identity, payments, and internationalization.',
  },
  {
    title: 'Performance governance at org scale',
    body: 'Founded a performance program across 200+ engineers and 25+ services with shared measurement, release gates, and delegation mechanisms, driving up to 5× checkout and 10.5× address resolution improvements.',
  },
  {
    title: 'Platform enablement',
    body: 'Architected a microfrontend platform that let 6+ teams and 11 microfrontends ship independently, reducing onboarding from weeks to days through shared tooling and automated compatibility validation.',
  },
  {
    title: 'Production AI systems',
    body: 'Built deterministic AI workflows for engineering automation, including a multi-stage pipeline and provenance-tracked knowledge graph, with hallucinations reduced below 2%.',
  },
];

const operateBlocks = [
  {
    title: 'Constraints before technology',
    body: 'The best architecture comes from understanding organizational, regulatory, and operational constraints first. I designed a global commerce experience around legal-entity boundaries and marketplace-scoped authentication, not around a framework preference.',
  },
  {
    title: 'Mechanisms that survive delegation',
    body: 'I build standards, tooling, and operating models that continue working without me. The performance program I founded now runs independently 30+ weeks after I transferred ownership.',
  },
  {
    title: 'Platforms over heroics',
    body: 'The highest-leverage work improves how teams build and ship, not just what they ship. A microfrontend platform that reduced onboarding from weeks to days has more compounding value than any single feature.',
  },
  {
    title: 'Measurable outcomes',
    body: 'I ground every technical decision in data: 5× checkout improvement, 10.5× address resolution, 45% build-time reduction, <2% hallucination rate. If it can\'t be measured, it can\'t be governed.',
  },
];

const timelineEntries = [
  {
    company: 'Amazon, Project Kuiper',
    description: 'Global commerce architecture across 88 countries, org-scale performance governance, microfrontend platform for 6+ teams, secure console payments, production AI systems',
  },
  {
    company: 'Amazon, QuickSight',
    description: 'Embedding SDK performance (28% latency reduction), customization strategy, test coverage improvement (42% → 73%), measurement frameworks',
  },
  {
    company: 'Amazon, AWS IoT',
    description: 'Monolith-to-microfrontend rearchitecture across 9 teams, 45% build reduction, 70% deployment improvement, console feature launches',
  },
];
---

<PageLayout>
  {/* ───────── Section 1: Hero ───────── */}
  <section class="py-16 md:py-24">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div>
        <p class="font-[var(--font-mono)] text-sm text-[var(--color-text-secondary)] mb-4">Staff Software Engineer · Amazon</p>
        <h1 class="text-4xl font-bold leading-tight md:text-5xl">
          I build the platforms, standards, and architecture that let large engineering organizations ship faster at global scale.
        </h1>
        <p class="mt-6 text-lg text-[var(--color-text-secondary)] leading-relaxed">
          Seattle-based staff engineer focused on the ambiguous, cross-org problems that sit between product, platform, and infrastructure. My work spans customer-facing commerce, org-wide performance governance, microfrontend platform enablement, secure identity and payments, and production AI systems across web, mobile, and console.
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          {proofChips.map((label, i) => (
            <span class="proof-chip-animated" style={`animation-delay: ${i * 50}ms`}>
              <ProofChip label={label} />
            </span>
          ))}
        </div>
        <div class="mt-8 flex flex-wrap gap-4">
          <PrimaryButton href="/work" label="View Selected Work" />
          <SecondaryButton href="/resume" label="View Resume" />
        </div>
      </div>
      <div class="flex justify-center md:justify-end">
        <img
          src="/images/headshot.webp"
          alt="Jonathan Rinciari"
          width="400"
          height="500"
          class="rounded-2xl w-full max-w-[400px] object-cover"
        />
      </div>
    </div>
  </section>

  {/* ───────── Section 2: Signature proof row ───────── */}
  <ScrollReveal>
    <section class="py-16 md:py-24">
      <h2 class="sr-only">Key contributions</h2>
      <div class="grid gap-6 sm:grid-cols-2">
        {signatureCards.map(card => (
          <div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6">
            <h3 class="text-lg font-semibold">{card.title}</h3>
            <p class="mt-2 text-sm text-[var(--color-text-secondary)] leading-relaxed">{card.body}</p>
          </div>
        ))}
      </div>
    </section>
  </ScrollReveal>

  {/* ───────── Section 3: Selected Work preview ───────── */}
  <ScrollReveal>
    <section class="py-16 md:py-24">
      <SectionHeader
        title="Selected Work"
        subtitle="A few examples of how I approach system design, technical direction, and org-level leverage."
      />
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {workEntries.map((entry, i) => (
          <ScrollReveal delay={i * 100} class="h-full">
            <WorkCard
              title={entry.data.title}
              summary={entry.data.summary}
              metrics={entry.data.metrics}
              href={`/work/${entry.id}`}
            />
          </ScrollReveal>
        ))}
      </div>
    </section>
  </ScrollReveal>

  {/* ───────── Section 4: How I operate ───────── */}
  <ScrollReveal>
    <section class="py-16 md:py-24">
      <SectionHeader title="How I work" />
      <div class="grid gap-8 md:grid-cols-2">
        {operateBlocks.map(block => (
          <div>
            <h3 class="text-lg font-semibold">{block.title}</h3>
            <p class="mt-2 text-sm text-[var(--color-text-secondary)] leading-relaxed">{block.body}</p>
          </div>
        ))}
      </div>
    </section>
  </ScrollReveal>

  {/* ───────── Section 5: What people say ───────── */}
  <ScrollReveal>
    <section class="py-16 md:py-24">
      <SectionHeader title="What people say" />
      <div class="grid gap-6 md:grid-cols-2">
        <div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6">
          <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed italic">
            "Jon is the most knowledgeable UI engineer I have ever seen. His design of micro-frontend architecture is thoroughly considerate. When a problem arises, you can trust that Jon can give the best advice."
          </p>
          <p class="mt-4 text-xs font-medium text-[var(--color-text)] font-[var(--font-mono)]">Peer, Amazon</p>
        </div>
        <div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6">
          <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed italic">
            "Jon's exceptional ability to solve complex technical problems while maintaining customer focus sets him apart. He consistently ensures technical solutions meet both immediate needs and long-term customer experience goals."
          </p>
          <p class="mt-4 text-xs font-medium text-[var(--color-text)] font-[var(--font-mono)]">Peer, Amazon</p>
        </div>
        <div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6">
          <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed italic">
            "Jon's super power is his ability to quickly and thoroughly resolve any technical problem that arises in his space. He is highly trusted to solve problems regardless of complexity or ambiguity."
          </p>
          <p class="mt-4 text-xs font-medium text-[var(--color-text)] font-[var(--font-mono)]">Peer, Amazon</p>
        </div>
        <div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6">
          <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed italic">
            "Jon consistently demonstrates a strong ability to solve complex technical problems across all web UI components and architectures. He quickly gets teams aligned on decisions impacting delivery."
          </p>
          <p class="mt-4 text-xs font-medium text-[var(--color-text)] font-[var(--font-mono)]">Engineering Manager, Amazon</p>
        </div>
      </div>
    </section>
  </ScrollReveal>

  {/* ───────── Section 6: Experience snapshot ───────── */}
  <ScrollReveal>
    <section class="py-16 md:py-24">
      <SectionHeader title="Recent focus" />
      <div>
        {timelineEntries.map(entry => (
          <TimelineItem company={entry.company} description={entry.description} />
        ))}
      </div>
      <div class="mt-6 text-right">
        <a href="/resume" class="text-sm font-medium text-[var(--color-accent)] hover:underline">
          View full resume &rarr;
        </a>
      </div>
    </section>
  </ScrollReveal>

  {/* ───────── Section 6: Contact CTA ───────── */}
  <ScrollReveal>
    <section class="py-16 md:py-24">
      <h2 class="text-3xl font-bold md:text-4xl">Interested in talking?</h2>
      <p class="mt-4 text-lg text-[var(--color-text-secondary)] leading-relaxed max-w-2xl">
        I'm looking for Staff, Principal, and Senior Staff roles where the core challenge is defining how complex software gets built across teams: customer-facing architecture, platform enablement, performance engineering, or applied AI infrastructure.
      </p>
      <p class="mt-3 text-sm text-[var(--color-text-secondary)]">
        Open to remote, Seattle/Bellevue-based, or relocation to Europe.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href={`mailto:${site.email || 'hello@jonrinciari.dev'}`}
          class="inline-flex items-center justify-center rounded-xl bg-[var(--color-accent)] px-6 py-3 text-sm font-medium text-white hover:opacity-90 transition-opacity duration-150 cursor-pointer min-h-[44px]"
        >
          Email me
        </a>
        <a
          href={site.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-xl border border-[var(--color-border)] px-6 py-3 text-sm font-medium text-[var(--color-text)] hover:border-[var(--color-text-secondary)] transition-colors duration-150 cursor-pointer min-h-[44px]"
        >
          LinkedIn
        </a>
        <a
          href="/resume"
          class="inline-flex items-center justify-center rounded-xl border border-[var(--color-border)] px-6 py-3 text-sm font-medium text-[var(--color-text)] hover:border-[var(--color-text-secondary)] transition-colors duration-150 cursor-pointer min-h-[44px]"
        >
          Resume
        </a>
      </div>
    </section>
  </ScrollReveal>
</PageLayout>

<style>
  @keyframes chip-fade-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .proof-chip-animated {
    opacity: 0;
    animation: chip-fade-in 300ms ease-out forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .proof-chip-animated {
      opacity: 1;
      animation: none;
    }
  }
</style>
