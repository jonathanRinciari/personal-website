---
import PageLayout from '../layouts/PageLayout.astro';
import ResumeDownloadButton from '../components/ResumeDownloadButton.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import { resume } from '../data/resume';
---
<PageLayout
  title="Resume | Jonathan Rinciari"
  description="Staff-level software engineer leading customer-facing architecture, platform enablement, performance governance, and applied AI systems at Amazon."
>
  <article class="mx-auto max-w-[var(--reading-width)] py-16 md:py-24">
    <!-- Header -->
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <h1 class="text-4xl font-bold">{resume.header.name}</h1>
        <p class="mt-1 text-sm text-[var(--color-text-secondary)] font-[var(--font-mono)]">
          {resume.header.location} · <a href={`mailto:${resume.header.email}`} class="text-[var(--color-accent)] hover:underline">{resume.header.email}</a>
        </p>
        <p class="mt-1 text-sm text-[var(--color-text-secondary)] font-[var(--font-mono)]">
          <a href={`https://${resume.header.linkedin}`} class="text-[var(--color-accent)] hover:underline">{resume.header.linkedin}</a> · <a href={`https://${resume.header.site}`} class="text-[var(--color-accent)] hover:underline">{resume.header.site}</a>
        </p>
      </div>
      <div class="flex gap-3 shrink-0">
        <ResumeDownloadButton />
      </div>
    </div>

    <!-- Positioning line -->
    <div class="mt-6 border-t border-b border-[var(--color-border)] py-3">
      <p class="text-xs font-semibold tracking-widest text-[var(--color-text-secondary)] uppercase">{resume.positioningLine}</p>
    </div>

    <!-- Summary -->
    <ScrollReveal class="mt-8">
      <p class="text-[var(--color-text-secondary)] leading-relaxed">{resume.summary}</p>
    </ScrollReveal>

    <!-- Selected Impact -->
    <ScrollReveal class="mt-10">
      <section>
        <h2 class="text-lg font-bold uppercase tracking-wider text-[var(--color-text)]">Selected Impact</h2>
        <div class="mt-4 space-y-3">
          {resume.selectedImpact.map(item => (
            <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed">
              <strong class="text-[var(--color-text)]">{item.bold}</strong> {item.detail}
            </p>
          ))}
        </div>
      </section>
    </ScrollReveal>

    <!-- Experience -->
    <ScrollReveal class="mt-12">
      <section>
        <h2 class="text-lg font-bold uppercase tracking-wider text-[var(--color-text)]">Experience</h2>
        <div class="mt-6 space-y-10">
          {resume.experience.map(role => (
            <div>
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h3 class="text-base font-bold">{role.title}</h3>
                <span class="text-xs text-[var(--color-text-secondary)] font-[var(--font-mono)]">{role.startDate} – {role.endDate}</span>
              </div>
              <p class="text-sm font-medium text-[var(--color-text-secondary)]">{role.company}</p>
              {role.subtitle && (
                <p class="mt-2 text-sm italic text-[var(--color-text-secondary)]">{role.subtitle}</p>
              )}
              <ul class="mt-3 space-y-2">
                {role.bullets.map(bullet => (
                  <li class="text-sm text-[var(--color-text-secondary)] leading-relaxed">
                    <strong class="text-[var(--color-text)]">{bullet.bold}</strong> {bullet.detail}
                  </li>
                ))}
              </ul>
              {role.workLink && (
                <a href={role.workLink} class="mt-3 inline-block text-sm text-[var(--color-accent)] hover:underline">View case study →</a>
              )}
            </div>
          ))}
        </div>
      </section>
    </ScrollReveal>

    <!-- Additional Experience -->
    <ScrollReveal class="mt-12">
      <section>
        <h2 class="text-lg font-bold uppercase tracking-wider text-[var(--color-text)]">Additional Experience</h2>
        <div class="mt-4 space-y-3">
          {resume.additionalExperience.map(role => (
            <div>
              <div class="flex flex-wrap items-baseline gap-2">
                <span class="text-sm font-semibold">{role.role}</span>
                <span class="text-xs text-[var(--color-text-secondary)] font-[var(--font-mono)]">{role.company} · {role.period}</span>
              </div>
              <p class="mt-0.5 text-sm text-[var(--color-text-secondary)]">{role.description}</p>
            </div>
          ))}
        </div>
      </section>
    </ScrollReveal>

    <!-- Technical Areas -->
    <ScrollReveal class="mt-12">
      <section>
        <h2 class="text-lg font-bold uppercase tracking-wider text-[var(--color-text)]">Technical Areas</h2>
        <div class="mt-4 space-y-2">
          {resume.technicalAreas.map(area => (
            <p class="text-sm text-[var(--color-text-secondary)]">
              <strong class="text-[var(--color-text)]">{area.category}:</strong> {area.items}
            </p>
          ))}
        </div>
      </section>
    </ScrollReveal>

    <!-- Education -->
    <ScrollReveal class="mt-12">
      <section>
        <h2 class="text-lg font-bold uppercase tracking-wider text-[var(--color-text)]">Education</h2>
        <div class="mt-4">
          {resume.education.map(edu => (
            <p class="text-sm text-[var(--color-text-secondary)]">{edu.degree}{edu.school ? `, ${edu.school}` : ''}</p>
          ))}
        </div>
      </section>
    </ScrollReveal>
  </article>
</PageLayout>
