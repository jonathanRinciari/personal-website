---
import PageLayout from '../layouts/PageLayout.astro';
import ResumeDownloadButton from '../components/ResumeDownloadButton.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import { resume } from '../data/resume';
---
<PageLayout
  title="Resume — Jonathan Rinciari"
  description="A concise view of my experience, recent impact, and the systems I've led."
>
  <article class="mx-auto max-w-[var(--reading-width)] py-16 md:py-24">
    <!-- Hero -->
    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
      <div>
        <h1 class="text-4xl font-bold">Resume</h1>
        <p class="mt-2 text-lg text-[var(--color-text-secondary)]">A concise view of my experience, recent impact, and the systems I've led.</p>
      </div>
      <div class="flex gap-3 shrink-0">
        <ResumeDownloadButton />
        <a href="/contact" class="inline-flex items-center rounded-xl border border-[var(--color-border)] px-5 py-2.5 text-sm font-medium text-[var(--color-text)] hover:border-[var(--color-text-secondary)] transition-colors duration-150 min-h-[44px]">Contact</a>
      </div>
    </div>

    <!-- Selected Outcomes -->
    <ScrollReveal class="mt-12">
      <section>
        <h2 class="text-2xl font-bold">Selected outcomes</h2>
        <ul class="mt-4 space-y-2 text-[var(--color-text-secondary)]">
          {resume.selectedOutcomes.map(outcome => (
            <li class="flex gap-2">
              <span class="text-[var(--color-accent)] shrink-0">&mdash;</span>
              <span>{outcome}</span>
            </li>
          ))}
        </ul>
      </section>
    </ScrollReveal>

    <!-- Experience -->
    <ScrollReveal class="mt-16">
      <section>
        <h2 class="text-2xl font-bold">Experience</h2>
        <div class="mt-6">
          {resume.experience.map(role => (
            <div class="mb-8 last:mb-0">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h3 class="text-lg font-semibold">{role.title}</h3>
                <span class="text-xs text-[var(--color-text-secondary)] font-[var(--font-mono)]">{role.startDate}&ndash;{role.endDate}</span>
              </div>
              <p class="text-sm text-[var(--color-text-secondary)]">{role.company}</p>
              <ul class="mt-2 list-disc pl-5 space-y-1 text-sm text-[var(--color-text-secondary)]">
                {role.bullets.map(bullet => <li>{bullet}</li>)}
              </ul>
              {role.workLink && (
                <a href={role.workLink} class="mt-2 inline-block text-sm text-[var(--color-accent)] hover:underline">View case study &rarr;</a>
              )}
            </div>
          ))}
        </div>
      </section>
    </ScrollReveal>

    <!-- Skills -->
    <ScrollReveal class="mt-16">
      <section>
        <h2 class="text-2xl font-bold">Skills & domains</h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {resume.skills.map(group => (
            <div>
              <p class="text-sm font-semibold">{group.category}</p>
              <p class="mt-1 text-sm text-[var(--color-text-secondary)]">{group.items.join(' \u00b7 ')}</p>
            </div>
          ))}
        </div>
      </section>
    </ScrollReveal>

    <!-- Education -->
    <ScrollReveal class="mt-16">
      <section>
        <h2 class="text-2xl font-bold">Education</h2>
        <div class="mt-4">
          {resume.education.map(edu => (
            <div>
              <p class="font-semibold">{edu.degree}</p>
              <p class="text-sm text-[var(--color-text-secondary)]">{edu.school} &middot; {edu.year}</p>
            </div>
          ))}
        </div>
      </section>
    </ScrollReveal>
  </article>
</PageLayout>
